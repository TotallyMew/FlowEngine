# Copy to .env and replace the empty passwords before starting Compose.
FLOW_DB_USER=flowengine
FLOW_DB_PASSWORD=
FLOW_DB_PORT=55432

FLOW_RABBIT_USER=flowengine
FLOW_RABBIT_PASSWORD=
FLOW_RABBIT_PORT=5672
FLOW_RABBIT_MANAGEMENT_PORT=15672

FLOW_OPERATOR_USERNAME=operator
# Use 12–72 UTF-8 bytes. Choose a distinct password.
FLOW_OPERATOR_PASSWORD=
# Set true when serving the application through HTTPS.
FLOW_SECURE_COOKIE=false
FLOW_WEB_PORT=5173
